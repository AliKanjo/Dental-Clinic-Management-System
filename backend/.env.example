# DentalFlow Environment Configuration
NODE_ENV=development
PORT=3000

# Required: Set a strong random secret (at least 32 characters)
JWT_SECRET=replace-with-a-strong-random-jwt-secret

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Clinic time zone (IANA name, e.g. Asia/Riyadh). Dentist shift hours are
# interpreted in this zone. Defaults to UTC.
CLINIC_TIMEZONE=UTC

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dental_clinic_db

# Demo Data Seeding (must be explicitly set to true; never used in production)
SEED_DEMO_DATA=false

# Email / SMTP Configuration (for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@dentalflow.local

# Optional AI Assistant Configuration
AISA_API_KEY=
AISA_BASE_URL=https://api.aisa.one/v1
